# Local development database (fast, no remote Hostinger latency)
# Copy this to server/.env and uncomment/edit the DB_* lines below.

NODE_ENV=development
APP_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=nexora_local
DB_USER=nexora
DB_PASSWORD=nexora_local_pw
DB_SSL=false
DB_POOL_LIMIT=10

APP_KEY=change-this-local-key
ENCRYPTION_KEY=change-this-local-key
JWT_SECRET=change-this-local-secret
JWT_EXPIRES_IN=7d

BCRYPT_ROUNDS=10
DEVELOPER_PASSWORD=NexoraDev@2026!
