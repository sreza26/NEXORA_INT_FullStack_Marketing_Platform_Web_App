NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

DATABASE_FILE=nexora.sqlite

CURRENCY=USD
MEMBER_CODE_PREFIX=NX
MEMBER_CODE_LENGTH=8

COMMISSION_ENABLED=true
COMMISSION_GENERATION=3
COMMISSION_RATES=0.10,0.05,0.03

WITHDRAWAL_ENABLED=true
WITHDRAWAL_MIN=50
WITHDRAWAL_MAX=10000
WITHDRAWAL_HOLD_DAYS=3

SALARY_ENABLED=true
SALARY_DAY=1
REWARDS_ENABLED=true

SPONSOR_REQUIRED=false

