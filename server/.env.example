NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIATES_IN=7d

# Key material for encrypting secrets at rest (withdrawal account details).
# Generate a fresh value with: node -e "console.log('base64:'+require('crypto').randomBytes(32).toString('base64'))"
APP_KEY=base64:REPLACE_WITH_A_RANDOM_32_BYTE_KEY=
ENCRYPTION_KEY=base64:REPLACE_WITH_A_RANDOM_32_BYTE_KEY=

# Password hashing cost (Laravel reference: 12).
BCRYPT_ROUNDS=12

# Rate limits.
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTRATION=10
RATE_LIMIT_SENSITIVE=10
RATE_LIMIT_CONTACT=10

DATABASE_FILE=nexora.sqlite

CURRENCY=USD
MEMBER_CODE_PREFIX=NX
MEMBER_CODE_LENGTH=8

COMMISSION_ENABLED=true
COMMISSION_GENERATION=3
COMMISSION_RATES=0.10,0.05,0.03

WITHDRAWAL_ENABLED=true
WITHDRAWAL_MIN=10
WITHDRAWAL_MAX=10000
WITHDRAWAL_HOLD_DAYS=3

SALARY_ENABLED=true
SALARY_DAY=1
REWARDS_ENABLED=true

SPONSOR_REQUIRED=false

