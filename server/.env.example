NODE_ENV=production
PORT=5000
APP_URL=https://nexoraint.net
CLIENT_ORIGIN=https://nexoraint.net,https://www.nexoraint.net

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-hex-string
JWT_EXPIRES_IN=7d

# Generate with: node -e "console.log('base64:'+require('crypto').randomBytes(32).toString('base64'))"
APP_KEY=base64:replace-with-a-random-32-byte-key
ENCRYPTION_KEY=base64:replace-with-a-random-32-byte-key

BCRYPT_ROUNDS=12

RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTRATION=10
RATE_LIMIT_SENSITIVE=10
RATE_LIMIT_CONTACT=10

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexora
DB_USER=nexora
DB_PASSWORD=change-me
DB_SSL=false
DB_POOL_LIMIT=10

CURRENCY=USD
MEMBER_CODE_PREFIX=NX
MEMBER_CODE_LENGTH=8

COMMISSION_ENABLED=true
COMMISSION_GENERATION=3
COMMISSION_RATES=0.10,0.05,0.03
COMMISSION_GENERATION_RATES=[{"generation_from":1,"generation_to":1,"rate":5},{"generation_from":2,"generation_to":2,"rate":3},{"generation_from":3,"generation_to":3,"rate":2},{"generation_from":4,"generation_to":5,"rate":1.5},{"generation_from":6,"generation_to":10,"rate":1},{"generation_from":11,"generation_to":20,"rate":0.5}]

WITHDRAWAL_ENABLED=true
WITHDRAWAL_MIN=10
WITHDRAWAL_MAX=10000
WITHDRAWAL_HOLD_DAYS=3

SALARY_ENABLED=true
SALARY_DAY=1
REWARDS_ENABLED=true

SPONSOR_REQUIRED=false

# Password for sreza26@gmail.com on first creation
DEVELOPER_PASSWORD=replace-with-a-strong-password
